{
  "name": "pico",
  "version": "1.6.0",
  "description": "Turn any website into a native desktop app",
  "main": "src/cli.js",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pico": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "gui": "electron src/gui.js",
    "test": "node --test tests/*.test.js",
    "build": "electron-builder"
  },
  "keywords": [
    "electron",
    "desktop",
    "app",
    "wrapper",
    "website",
    "native"
  ],
  "author": "ne0k1r4 <neok1ra@proton.me>",
  "license": "MIT",
  "dependencies": {
    "chalk": "^6.0.0",
    "fs-extra": "^11.4.0",
    "inquirer": "^14.0.2"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.pico.builder",
    "productName": "Pico App Generator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
